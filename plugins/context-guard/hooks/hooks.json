{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}\\scripts\\context-guard.ps1\"; exit $LASTEXITCODE",
            "shell": "powershell",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/context-guard.sh\"",
            "shell": "bash",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
